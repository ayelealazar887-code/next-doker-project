```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
dist/
build/
out/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE / Editors
.vscode/
.idea/

# Prisma generated files
# Uncomment if your generated Prisma client is inside these directories
# generated/
# prisma/generated/

# Temporary files
tmp/
temp/

# Docker
docker-compose.override.yml
```
